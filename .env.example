# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# Random secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 to enable Flask's debug mode/reloader (local dev only -- never in
# production, the interactive debugger allows remote code execution).
FLASK_DEBUG=1

PORT=5050
